po:Comprime a owl:Class ;
    rdfs:label "Comprimé"@fr ;
    rdfs:comment "Unité pharmaceutique solide sous forme de comprimé."@fr ;
    rdfs:subClassOf po:FormeSolide .

po:FormePharmaceutique a owl:Class ;
    rdfs:label "Forme pharmaceutique"@fr ;
    rdfs:comment "Concept de forme du médicament, distinct de la spécialité."@fr .

po:age a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "âge fictif en années"@fr ;
    rdfs:domain po:Patient ;
    rdfs:range xsd:integer .

po:Adulte a owl:Class ;
    rdfs:label "Adulte"@fr ;
    rdfs:comment "Classe définie par l’âge entier : 18 ans ou plus. Convention pédagogique du projet, sans règle de prescription."@fr ;
    rdfs:subClassOf po:Patient ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Patient [ a owl:Restriction ;
                        owl:onProperty po:age ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 18 ] ) ] ] ) ] .

po:ContreIndication a owl:Class ;
    rdfs:label "Contre-indication"@fr ;
    rdfs:comment "Condition documentée pour une spécialité. Le corpus ne couvre pas toutes les conditions du RCP."@fr .

po:MedicamentComprime a owl:Class ;
    rdfs:label "Médicament en comprimé oral"@fr ;
    rdfs:comment "Spécialité orale possédant une forme appartenant à Comprime."@fr ;
    rdfs:subClassOf po:MedicamentOral ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:MedicamentOral [ a owl:Restriction ;
                        owl:onProperty po:aFormePharmaceutique ;
                        owl:someValuesFrom po:Comprime ] ) ] .

po:CIAbsolue a owl:Class ;
    rdfs:label "Contre-indication absolue"@fr ;
    rdfs:comment "Situation explicitement présentée comme une contre-indication dans la source."@fr ;
    rdfs:subClassOf po:ContreIndication .

po:EffetSecondaire a owl:Class ;
    rdfs:label "Effet indésirable"@fr ;
    rdfs:comment "Concept d’effet possible, sans fréquence universelle. La fréquence dépend du médicament via ObservationEffet."@fr .

po:MedicamentOral a owl:Class ;
    rdfs:label "Médicament par voie orale"@fr ;
    rdfs:comment "Spécialité ayant une voie d’administration appartenant à VoieOrale."@fr ;
    rdfs:subClassOf po:Medicament ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:aVoieAdministration ;
                        owl:someValuesFrom po:VoieOrale ] ) ] .

po:PrincipeActif a owl:Class ;
    rdfs:label "Principe actif"@fr ;
    rdfs:comment "Substance active. La masse déclarée peut correspondre à un sel précisé par substanceDosee."@fr .

po:contientPrincipeActif a owl:ObjectProperty ;
    rdfs:label "contient le principe actif"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:PrincipeActif ;
    owl:inverseOf po:estPrincipeActifDe .

po:ObservationEffet a owl:Class ;
    rdfs:label "Association médicament effet"@fr ;
    rdfs:comment "Association documentée entre une spécialité et un effet possible, avec fréquence contextualisée."@fr .

po:Pathologie a owl:Class ;
    rdfs:label "État clinique"@fr ;
    rdfs:comment "Maladie, symptôme ou état clinique pertinent dans ce modèle simplifié."@fr .

po:Patient a owl:Class ;
    rdfs:label "Patient fictif"@fr ;
    rdfs:comment "Personne fictive utilisée exclusivement dans les scénarios de démonstration."@fr .

po:Medicament a owl:Class ;
    rdfs:label "Médicament"@fr ;
    rdfs:comment "Spécialité pharmaceutique, à dosage et forme déterminés. Périmètre réglementaire français."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty po:contientPrincipeActif ;
            owl:someValuesFrom po:PrincipeActif ],
        [ a owl:Restriction ;
            owl:onClass po:FormePharmaceutique ;
            owl:onProperty po:aFormePharmaceutique ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty po:aVoieAdministration ;
            owl:someValuesFrom po:VoieAdministration ] .

[] a owl:AllDisjointClasses ;
    owl:members ( po:CIAbsolue po:CIRelative ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:SurOrdonnance po:SansOrdonnance ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:Adolescent po:JeuneEnfant ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:Medicament po:PrincipeActif po:EffetSecondaire po:ContreIndication po:Patient po:Pathologie po:ObservationEffet po:FormePharmaceutique po:VoieAdministration ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:AdulteJeune po:AdulteMoyenAge po:PersonneAgee ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( po:AcidoseLactique po:AdministrationOrale po:Advil_400 po:AllergiePenicillines po:Amoxicilline po:Amoxicilline_BGR_1g po:AngineStreptococcique po:CI_AllergiePenicillines po:CI_InsuffisanceRenaleSevere po:CI_UlcereEvolutif po:Clamoxyl_1g po:Coumadine_5 po:DiabeteType2 po:Diarrhee po:DouleurAigue po:FormeComprimeDispersible po:FormeComprimeEnrobe po:FormeComprimePellicule po:FormeComprimeSecable po:Glucophage_850 po:Hemorragie po:Ibuprofene po:InsuffisanceRenaleSevere po:MaladieThromboembolique po:Metformine po:Metformine_BGR_850 po:Obs_Advil_400_TroublesDigestifs po:Obs_Amoxicilline_BGR_1g_Diarrhee po:Obs_Clamoxyl_1g_Diarrhee po:Obs_Coumadine_5_Hemorragie po:Obs_Glucophage_850_AcidoseLactique po:Obs_Glucophage_850_TroublesDigestifs po:Obs_Metformine_BGR_850_AcidoseLactique po:Obs_Metformine_BGR_850_TroublesDigestifs po:Patient_P001 po:Patient_P002 po:Patient_P003 po:Patient_P004 po:Patient_P005 po:TroublesDigestifs po:UlcereGastroduodenalEvolutif po:Warfarine ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:ObservationFrequente po:ObservationTresFrequente po:ObservationRare po:ObservationTresRare po:ObservationPeuFrequente po:ObservationFrequenceNonQuantifiee ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:Adulte po:Enfant ) .

[] a owl:Axiom ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/63646874/extrait> ;
    owl:annotatedProperty po:interagitAvec ;
    owl:annotatedSource po:Ibuprofene ;
    owl:annotatedTarget po:Warfarine .

[] a owl:AllDisjointClasses ;
    owl:members ( po:Princeps po:Generique ) .

