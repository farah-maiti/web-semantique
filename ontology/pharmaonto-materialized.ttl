@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix po: <http://www.esprit.tn/pharmaonto#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:AnnotationProperty .

dcterms:date a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

<http://www.esprit.tn/pharmaonto> a owl:Ontology ;
    rdfs:label "PharmaOnto"@fr ;
    dcterms:creator "Ahmed Saidani",
        "Farah Maiti",
        "Fedi Ben Khalifa" ;
    rdfs:comment "Projet pédagogique Web Sémantique, ESPRIT 5 TWIN 2026-2027. Corpus partiel français, patients fictifs. Les alertes illustrent le raisonnement et ne constituent pas un avis médical."@fr ;
    owl:versionInfo "3.0.0" .

po:FemmeEnceinte a owl:Class ;
    rdfs:label "Patiente enceinte"@fr ;
    rdfs:comment "Catégorie indépendante de la classe d’âge. Aucun scénario de grossesse dans le corpus."@fr ;
    rdfs:subClassOf po:Patient .

po:PersonneTresAgee a owl:Class ;
    rdfs:label "Personne de 80 ans ou plus"@fr ;
    rdfs:comment "Classe définie par l’âge entier : 80 ans ou plus. Convention pédagogique du projet, sans règle de prescription."@fr ;
    rdfs:subClassOf po:PersonneAgee ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Patient [ a owl:Restriction ;
                        owl:onProperty po:age ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 80 ] ) ] ] ) ] .

po:aPourContreIndication a owl:ObjectProperty ;
    rdfs:label "a pour contre-indication"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:ContreIndication .

po:codeCIS a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "code CIS français"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:string .

po:description a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "description de la condition"@fr ;
    rdfs:domain po:ContreIndication ;
    rdfs:range xsd:string .

po:donneeFictive a owl:AnnotationProperty .

po:dosageMg a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "masse par unité en mg"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:decimal .

po:estContreIndiquePour a owl:ObjectProperty ;
    rdfs:label "alerte de contre-indication pour"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:Patient .

po:formeGalenique a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "forme galénique"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:string .

po:frequence a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fréquence pour cette spécialité"@fr ;
    rdfs:domain po:ObservationEffet ;
    rdfs:range xsd:string .

po:interactionMedicamenteuseAvec a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "interaction entre spécialités"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:Medicament .

po:nomCommercial a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "nom de la spécialité"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:string .

po:notePortee a owl:AnnotationProperty .

po:provoque a owl:ObjectProperty ;
    rdfs:label "peut provoquer"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:EffetSecondaire ;
    owl:propertyChainAxiom ( po:aObservationEffet po:effetObserve ) .

po:substanceDosee a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "substance correspondant à la masse"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:string .

po:traite a owl:ObjectProperty ;
    rdfs:label "a une indication documentée pour"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:Pathologie ;
    owl:inverseOf po:estTraitePar .

po:Adolescent a owl:Class ;
    rdfs:label "Adolescent"@fr ;
    rdfs:comment "Classe définie par l’âge entier : 12 à 17 ans. Convention pédagogique du projet, sans règle de prescription."@fr ;
    rdfs:subClassOf po:Enfant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Patient [ a owl:Restriction ;
                        owl:onProperty po:age ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 12 ] [ xsd:maxInclusive 17 ] ) ] ] ) ] .

po:AffectionThromboembolique a owl:Class ;
    rdfs:label "Affection thromboembolique"@fr ;
    rdfs:comment "Affection liée à un thrombus ou une embolie."@fr ;
    rdfs:subClassOf po:AffectionVasculaire .

po:AffectionUlcereuse a owl:Class ;
    rdfs:label "Affection ulcéreuse gastroduodénale"@fr ;
    rdfs:comment "Atteinte ulcéreuse gastroduodénale."@fr ;
    rdfs:subClassOf po:AffectionGastroDuodenale .

po:CIDigestive a owl:Class ;
    rdfs:label "Contre-indication digestive"@fr ;
    rdfs:comment "Contre-indication absolue portant sur affection digestive."@fr ;
    rdfs:subClassOf po:CIAbsolue ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:CIAbsolue [ a owl:Restriction ;
                        owl:onProperty po:concerne ;
                        owl:someValuesFrom po:AffectionDigestive ] ) ] .

po:CIHypersensibilite a owl:Class ;
    rdfs:label "Contre-indication d’hypersensibilité"@fr ;
    rdfs:comment "Contre-indication absolue portant sur hypersensibilité médicamenteuse."@fr ;
    rdfs:subClassOf po:CIAbsolue ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:CIAbsolue [ a owl:Restriction ;
                        owl:onProperty po:concerne ;
                        owl:someValuesFrom po:HypersensibiliteMedicamenteuse ] ) ] .

po:CIRelative a owl:Class ;
    rdfs:label "Précaution relative"@fr ;
    rdfs:comment "Catégorie conservée pour extension. Elle ne déclenche pas la règle de contre-indication absolue."@fr ;
    rdfs:subClassOf po:ContreIndication .

po:CIRenale a owl:Class ;
    rdfs:label "Contre-indication rénale"@fr ;
    rdfs:comment "Contre-indication absolue portant sur affection rénale."@fr ;
    rdfs:subClassOf po:CIAbsolue ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:CIAbsolue [ a owl:Restriction ;
                        owl:onProperty po:concerne ;
                        owl:someValuesFrom po:AffectionRenale ] ) ] .

po:DeficitRenalSevere a owl:Class ;
    rdfs:label "Déficit rénal sévère"@fr ;
    rdfs:comment "Catégorie accueillant le scénario de DFG inférieur à 30 mL/min du corpus."@fr ;
    rdfs:subClassOf po:DeficitFonctionRenale .

po:EffetHemorragique a owl:Class ;
    rdfs:label "Effet hémorragique"@fr ;
    rdfs:comment "Effet indésirable caractérisé par un saignement."@fr ;
    rdfs:subClassOf po:EffetSecondaire .

po:HypersensibilitePenicillines a owl:Class ;
    rdfs:label "Hypersensibilité aux pénicillines"@fr ;
    rdfs:comment "Hypersensibilité spécifiquement documentée aux pénicillines."@fr ;
    rdfs:subClassOf po:HypersensibiliteBetaLactamines .

po:InfectionORLBacterienne a owl:Class ;
    rdfs:label "Infection ORL bactérienne"@fr ;
    rdfs:comment "Infection bactérienne de la sphère ORL ; l’angine streptococcique du corpus en est un exemple."@fr ;
    rdfs:subClassOf po:InfectionBacterienne .

po:JeuneEnfant a owl:Class ;
    rdfs:label "Enfant de moins de 12 ans"@fr ;
    rdfs:comment "Classe définie par l’âge entier : 0 à 11 ans. Convention pédagogique du projet, sans règle de prescription."@fr ;
    rdfs:subClassOf po:Enfant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Patient [ a owl:Restriction ;
                        owl:onProperty po:age ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 11 ] ) ] ] ) ] .

po:MedicamentAnalgesique a owl:Class ;
    rdfs:label "Médicament analgésique"@fr ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/63646874/extrait> ;
    rdfs:comment "Spécialité contenant au moins une substance de la famille analgésique. Classe définie : appartenance calculable par HermiT."@fr ;
    rdfs:subClassOf po:Medicament ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:Analgesique ] ) ] .

po:MedicamentAntivitamineK a owl:Class ;
    rdfs:label "Médicament antivitamine K"@fr ;
    dcterms:source <https://atcddd.fhi.no/atc_ddd_index/?code=B01AA03> ;
    rdfs:comment "Spécialité contenant au moins une substance de la famille antivitamine k. Classe définie : appartenance calculable par HermiT."@fr ;
    rdfs:subClassOf po:MedicamentAnticoagulant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:AntivitamineK ] ) ] .

po:MedicamentComprimeSecable a owl:Class ;
    rdfs:label "Médicament en comprimé sécable"@fr ;
    rdfs:comment "Classe définie par la voie orale et la forme pharmaceutique."@fr ;
    rdfs:subClassOf po:MedicamentComprime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:MedicamentOral [ a owl:Restriction ;
                        owl:onProperty po:aFormePharmaceutique ;
                        owl:someValuesFrom po:ComprimeSecable ] ) ] .

po:MedicamentDerivePropionique a owl:Class ;
    rdfs:label "Médicament à dérivé propionique"@fr ;
    dcterms:source <https://atcddd.fhi.no/atc_ddd_index/?code=M01AE01> ;
    rdfs:comment "Spécialité contenant au moins une substance de la famille dérivé de l’acide propionique. Classe définie : appartenance calculable par HermiT."@fr ;
    rdfs:subClassOf po:MedicamentAINS ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:DeriveAcidePropionique ] ) ] .

po:ObservationPeuFrequente a owl:Class ;
    rdfs:label "Effet peu fréquent pour ce médicament"@fr ;
    rdfs:comment "Fréquence entre 1/1000 inclus et 1/100 exclu. Catégorie disponible, non renseignée dans le corpus actuel."@fr ;
    rdfs:subClassOf po:ObservationEffet .

po:ObservationRare a owl:Class ;
    rdfs:label "Effet rare pour ce médicament"@fr ;
    rdfs:comment "Fréquence entre 1/10000 inclus et 1/1000 exclu selon le RCP."@fr ;
    rdfs:subClassOf po:ObservationEffet .

po:PatientAvecPlusieursMedicaments a owl:Class ;
    rdfs:label "Patient avec plusieurs médicaments"@fr ;
    rdfs:comment "Profil de démonstration : au moins deux spécialités distinctes enregistrées. Ce seuil ne prétend pas définir la polymédication clinique."@fr ;
    rdfs:subClassOf po:Patient ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Patient [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass po:Medicament ;
                        owl:onProperty po:prend ] ) ] .

po:SymptomeDouloureux a owl:Class ;
    rdfs:label "Symptôme douloureux"@fr ;
    rdfs:comment "Symptôme caractérisé par une douleur."@fr ;
    rdfs:subClassOf po:Symptome .

po:TroubleAcidoBasique a owl:Class ;
    rdfs:label "Trouble acido-basique"@fr ;
    rdfs:comment "Effet métabolique portant sur l’équilibre acido-basique."@fr ;
    rdfs:subClassOf po:EffetMetabolique .

po:TroubleGlycemique a owl:Class ;
    rdfs:label "Trouble glycémique"@fr ;
    rdfs:comment "Affection métabolique portant sur la régulation de la glycémie."@fr ;
    rdfs:subClassOf po:AffectionMetabolique .

po:TroubleTransit a owl:Class ;
    rdfs:label "Trouble du transit"@fr ;
    rdfs:comment "Effet digestif portant sur le transit intestinal."@fr ;
    rdfs:subClassOf po:EffetDigestif .

po:aObservationEffet a owl:ObjectProperty ;
    rdfs:label "a une association avec un effet"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:ObservationEffet ;
    owl:inverseOf po:observationDe .

po:effetObserve a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "effet associé"@fr ;
    rdfs:domain po:ObservationEffet ;
    rdfs:range po:EffetSecondaire .

po:estGeneriqueDe a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "est générique de"@fr ;
    rdfs:domain po:Generique ;
    rdfs:range po:Princeps .

po:estPrincipeActifDe a owl:ObjectProperty ;
    rdfs:label "est principe actif de"@fr ;
    rdfs:domain po:PrincipeActif ;
    rdfs:range po:Medicament .

po:estPrisPar a owl:ObjectProperty ;
    rdfs:label "est pris par"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:Patient .

po:estTraitePar a owl:ObjectProperty ;
    rdfs:label "a pour médicament indiqué"@fr ;
    rdfs:domain po:Pathologie ;
    rdfs:range po:Medicament .

po:interagitAvec a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "interaction documentée avec"@fr ;
    rdfs:domain po:PrincipeActif ;
    rdfs:range po:PrincipeActif .

po:observationDe a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "spécialité concernée"@fr ;
    rdfs:domain po:ObservationEffet ;
    rdfs:range po:Medicament .

po:prend a owl:ObjectProperty ;
    rdfs:label "prend dans le scénario"@fr ;
    rdfs:domain po:Patient ;
    rdfs:range po:Medicament ;
    owl:inverseOf po:estPrisPar .

po:souffreDe a owl:ObjectProperty ;
    rdfs:label "présente l’état clinique"@fr ;
    rdfs:domain po:Patient ;
    rdfs:range po:Pathologie .

po:AdulteJeune a owl:Class ;
    rdfs:label "Adulte de 18 à 44 ans"@fr ;
    rdfs:comment "Classe définie par l’âge entier : 18 à 44 ans. Convention pédagogique du projet, sans règle de prescription."@fr ;
    rdfs:subClassOf po:Adulte ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Patient [ a owl:Restriction ;
                        owl:onProperty po:age ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 18 ] [ xsd:maxInclusive 44 ] ) ] ] ) ] .

po:AffectionGastroDuodenale a owl:Class ;
    rdfs:label "Affection gastroduodénale"@fr ;
    rdfs:comment "Affection de l’estomac ou du duodénum."@fr ;
    rdfs:subClassOf po:AffectionDigestive .

po:AffectionMetabolique a owl:Class ;
    rdfs:label "Affection métabolique"@fr ;
    rdfs:comment "État clinique affectant le métabolisme."@fr ;
    rdfs:subClassOf po:Pathologie .

po:AffectionVasculaire a owl:Class ;
    rdfs:label "Affection vasculaire"@fr ;
    rdfs:comment "Affection des vaisseaux ou de la circulation."@fr ;
    rdfs:subClassOf po:Pathologie .

po:Analgesique a owl:Class ;
    rdfs:label "Analgésique"@fr ;
    rdfs:comment "Substance utilisée pour soulager la douleur."@fr ;
    rdfs:subClassOf po:PrincipeActif .

po:AntivitamineK a owl:Class ;
    rdfs:label "Antivitamine K"@fr ;
    dcterms:source <https://atcddd.fhi.no/atc_ddd_index/?code=B01AA03> ;
    rdfs:comment "Anticoagulant antagoniste de la vitamine K ; comprend la warfarine."@fr ;
    rdfs:subClassOf po:Anticoagulant .

po:Biguanide a owl:Class ;
    rdfs:label "Biguanide"@fr ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/67547090/extrait> ;
    rdfs:comment "Famille antidiabétique comprenant la metformine."@fr ;
    rdfs:subClassOf po:Antidiabetique .

po:CI_UlcereEvolutif a po:CIAbsolue,
        po:CIDigestive,
        po:ContreIndication,
        owl:NamedIndividual ;
    rdfs:label "Ulcère gastroduodénal en évolution"@fr ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/63646874/extrait> ;
    po:concerne po:UlcereGastroduodenalEvolutif ;
    po:description "Ulcère gastroduodénal en évolution"^^xsd:string .

po:ComprimeDispersible a owl:Class ;
    rdfs:label "Comprimé dispersible"@fr ;
    rdfs:comment "Comprimé destiné à être dispersé selon les conditions de son RCP."@fr ;
    rdfs:subClassOf po:Comprime .

po:ComprimePellicule a owl:Class ;
    rdfs:label "Comprimé pelliculé"@fr ;
    rdfs:comment "Comprimé avec un enrobage sous forme de film."@fr ;
    rdfs:subClassOf po:ComprimeEnrobe .

po:ComprimeSecable a owl:Class ;
    rdfs:label "Comprimé sécable"@fr ;
    rdfs:comment "Forme décrite comme sécable dans la fiche ; ne présume pas une adaptation de dose."@fr ;
    rdfs:subClassOf po:Comprime .

po:DeficitFonctionRenale a owl:Class ;
    rdfs:label "Déficit de fonction rénale"@fr ;
    rdfs:comment "Altération de la fonction rénale."@fr ;
    rdfs:subClassOf po:AffectionRenale .

po:DeriveAcidePropionique a owl:Class ;
    rdfs:label "Dérivé de l’acide propionique"@fr ;
    dcterms:source <https://atcddd.fhi.no/atc_ddd_index/?code=M01AE01> ;
    rdfs:comment "Sous-famille des AINS comprenant l’ibuprofène."@fr ;
    rdfs:subClassOf po:AntiInflammatoireNonSteroidien .

po:EffetMetabolique a owl:Class ;
    rdfs:label "Effet métabolique"@fr ;
    rdfs:comment "Effet indésirable touchant le métabolisme."@fr ;
    rdfs:subClassOf po:EffetSecondaire .

po:FormeComprimeEnrobe a po:Comprime,
        po:ComprimeEnrobe,
        po:FormePharmaceutique,
        po:FormeSolide,
        owl:NamedIndividual ;
    rdfs:label "comprimé enrobé"@fr .

po:FormeComprimeSecable a po:Comprime,
        po:ComprimeSecable,
        po:FormePharmaceutique,
        po:FormeSolide,
        owl:NamedIndividual ;
    rdfs:label "comprimé sécable"@fr .

po:HypersensibiliteBetaLactamines a owl:Class ;
    rdfs:label "Hypersensibilité aux bêta-lactamines"@fr ;
    rdfs:comment "Hypersensibilité documentée à une bêta-lactamine ; ne généralise pas les réactions croisées."@fr ;
    rdfs:subClassOf po:HypersensibiliteMedicamenteuse .

po:InfectionBacterienne a owl:Class ;
    rdfs:label "Infection bactérienne"@fr ;
    rdfs:comment "Affection infectieuse attribuée à une bactérie."@fr ;
    rdfs:subClassOf po:MaladieInfectieuse .

po:MaladieChronique a owl:Class ;
    rdfs:label "Maladie chronique"@fr ;
    rdfs:comment "Affection chronique."@fr ;
    rdfs:subClassOf po:Pathologie .

po:MaladieInfectieuse a owl:Class ;
    rdfs:label "Maladie infectieuse"@fr ;
    rdfs:comment "Affection infectieuse."@fr ;
    rdfs:subClassOf po:Pathologie .

po:MedicamentAINS a owl:Class ;
    rdfs:label "Médicament AINS"@fr ;
    dcterms:source <https://atcddd.fhi.no/atc_ddd_index/?code=M01AE01> ;
    rdfs:comment "Spécialité contenant au moins une substance de la famille anti-inflammatoire non stéroïdien. Classe définie : appartenance calculable par HermiT."@fr ;
    rdfs:subClassOf po:MedicamentAntiInflammatoire ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:AntiInflammatoireNonSteroidien ] ) ] .

po:MedicamentAntiInflammatoire a owl:Class ;
    rdfs:label "Médicament anti-inflammatoire"@fr ;
    dcterms:source <https://atcddd.fhi.no/atc_ddd_index/?code=M01AE01> ;
    rdfs:comment "Spécialité contenant au moins une substance de la famille anti-inflammatoire. Classe définie : appartenance calculable par HermiT."@fr ;
    rdfs:subClassOf po:Medicament ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:AntiInflammatoire ] ) ] .

po:MedicamentAnticoagulant a owl:Class ;
    rdfs:label "Médicament anticoagulant"@fr ;
    dcterms:source <https://atcddd.fhi.no/atc_ddd_index/?code=B01AA03> ;
    rdfs:comment "Spécialité contenant au moins une substance de la famille anticoagulant. Classe définie : appartenance calculable par HermiT."@fr ;
    rdfs:subClassOf po:MedicamentAntithrombotique ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:Anticoagulant ] ) ] .

po:MedicamentAntithrombotique a owl:Class ;
    rdfs:label "Médicament antithrombotique"@fr ;
    dcterms:source <https://atcddd.fhi.no/atc_ddd_index/?code=B01AA03> ;
    rdfs:comment "Spécialité contenant au moins une substance de la famille antithrombotique. Classe définie : appartenance calculable par HermiT."@fr ;
    rdfs:subClassOf po:Medicament ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:Antithrombotique ] ) ] .

po:MedicamentBiguanide a owl:Class ;
    rdfs:label "Médicament biguanide"@fr ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/67547090/extrait> ;
    rdfs:comment "Spécialité contenant au moins une substance de la famille biguanide. Classe définie : appartenance calculable par HermiT."@fr ;
    rdfs:subClassOf po:MedicamentAntidiabetique ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:Biguanide ] ) ] .

po:MedicamentComprimeDispersible a owl:Class ;
    rdfs:label "Médicament en comprimé dispersible"@fr ;
    rdfs:comment "Classe définie par la voie orale et la forme pharmaceutique."@fr ;
    rdfs:subClassOf po:MedicamentComprime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:MedicamentOral [ a owl:Restriction ;
