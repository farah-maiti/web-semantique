po:Obs_Glucophage_850_TroublesDigestifs a po:ObservationTresFrequente,
        owl:NamedIndividual ;
    rdfs:label "Glucophage_850 : TroublesDigestifs"@fr ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/67547090/extrait> ;
    po:effetObserve po:TroublesDigestifs ;
    po:frequence "très fréquent"^^xsd:string ;
    po:observationDe po:Glucophage_850 .

po:Obs_Metformine_BGR_850_AcidoseLactique a po:ObservationGrave,
        po:ObservationTresRare,
        owl:NamedIndividual ;
    rdfs:label "Metformine_BGR_850 : AcidoseLactique"@fr ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/60754492/extrait> ;
    po:effetObserve po:AcidoseLactique ;
