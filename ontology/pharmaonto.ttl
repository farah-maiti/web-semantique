po:CIAbsolue a owl:Class ;
    rdfs:label "Contre-indication absolue"@fr ;
    rdfs:comment "Situation explicitement présentée comme une contre-indication dans la source."@fr ;
    rdfs:subClassOf po:ContreIndication .

po:Generique a owl:Class ;
    rdfs:label "Médicament générique"@fr ;
    rdfs:comment "Spécialité rattachée à exactement une référence dans ce corpus."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass po:Princeps ;
            owl:onProperty po:estGeneriqueDe ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        po:Medicament .

