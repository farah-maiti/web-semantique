po:Princeps a owl:Class ;
    rdfs:label "Médicament de référence"@fr ;
    rdfs:comment "Référence du groupe générique considéré dans le corpus français."@fr ;
    rdfs:subClassOf po:Medicament .

po:ContreIndication a owl:Class ;
    rdfs:label "Contre-indication"@fr ;
    rdfs:comment "Condition documentée pour une spécialité. Le corpus ne couvre pas toutes les conditions du RCP."@fr .

po:SurOrdonnance a owl:Class ;
    rdfs:label "Sur ordonnance"@fr ;
    rdfs:comment "Statut français relevé à la date de consultation."@fr ;
    rdfs:subClassOf po:Medicament .

po:EffetSecondaire a owl:Class ;
    rdfs:label "Effet indésirable"@fr ;
    rdfs:comment "Concept d’effet possible, sans fréquence universelle. La fréquence dépend du médicament via ObservationEffet."@fr .

po:Patient a owl:Class ;
    rdfs:label "Patient fictif"@fr ;
    rdfs:comment "Personne fictive utilisée exclusivement dans les scénarios de démonstration."@fr .

po:PrincipeActif a owl:Class ;
    rdfs:label "Principe actif"@fr ;
    rdfs:comment "Substance active. La masse déclarée peut correspondre à un sel précisé par substanceDosee."@fr .

po:ObservationEffet a owl:Class ;
    rdfs:label "Association médicament effet"@fr ;
    rdfs:comment "Association documentée entre une spécialité et un effet possible, avec fréquence contextualisée."@fr .

po:Pathologie a owl:Class ;
    rdfs:label "État clinique"@fr ;
    rdfs:comment "Maladie, symptôme ou état clinique pertinent dans ce modèle simplifié."@fr .

po:Medicament a owl:Class ;
    rdfs:label "Médicament"@fr ;
    rdfs:comment "Spécialité pharmaceutique, à dosage et forme déterminés. Périmètre réglementaire français."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty po:contientPrincipeActif ;
            owl:someValuesFrom po:PrincipeActif ] .

[] a owl:AllDisjointClasses ;
    owl:members ( po:Adulte po:Enfant ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( po:AcidoseLactique po:Advil_400 po:AllergiePenicillines po:Amoxicilline po:Amoxicilline_BGR_1g po:AngineStreptococcique po:CI_AllergiePenicillines po:CI_InsuffisanceRenaleSevere po:CI_UlcereEvolutif po:Clamoxyl_1g po:Coumadine_5 po:DiabeteType2 po:Diarrhee po:DouleurAigue po:Glucophage_850 po:Hemorragie po:Ibuprofene po:InsuffisanceRenaleSevere po:MaladieThromboembolique po:Metformine po:Metformine_BGR_850 po:Obs_Advil_400_TroublesDigestifs po:Obs_Amoxicilline_BGR_1g_Diarrhee po:Obs_Clamoxyl_1g_Diarrhee po:Obs_Coumadine_5_Hemorragie po:Obs_Glucophage_850_AcidoseLactique po:Obs_Glucophage_850_TroublesDigestifs po:Obs_Metformine_BGR_850_AcidoseLactique po:Obs_Metformine_BGR_850_TroublesDigestifs po:Patient_P001 po:Patient_P002 po:Patient_P003 po:Patient_P004 po:Patient_P005 po:TroublesDigestifs po:UlcereGastroduodenalEvolutif po:Warfarine ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:SurOrdonnance po:SansOrdonnance ) .

[] a owl:Axiom ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/63646874/extrait> ;
    owl:annotatedProperty po:interagitAvec ;
    owl:annotatedSource po:Ibuprofene ;
    owl:annotatedTarget po:Warfarine .

[] a owl:AllDisjointClasses ;
    owl:members ( po:Medicament po:PrincipeActif po:EffetSecondaire po:ContreIndication po:Patient po:Pathologie po:ObservationEffet ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:ObservationFrequente po:ObservationTresFrequente po:ObservationRare po:ObservationTresRare ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:CIAbsolue po:CIRelative ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:Princeps po:Generique ) .

