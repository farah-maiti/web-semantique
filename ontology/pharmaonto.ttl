po:Obs_Metformine_BGR_850_TroublesDigestifs a po:ObservationTresFrequente,
        owl:NamedIndividual ;
    rdfs:label "Metformine_BGR_850 : TroublesDigestifs"@fr ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/60754492/extrait> ;
    po:effetObserve po:TroublesDigestifs ;
    po:frequence "très fréquent"^^xsd:string ;
    po:observationDe po:Metformine_BGR_850 .

po:ObservationRare a owl:Class ;
    rdfs:label "Effet rare pour ce médicament"@fr ;
    rdfs:comment "Fréquence entre 1/10000 inclus et 1/1000 exclu selon le RCP."@fr ;
    rdfs:subClassOf po:ObservationEffet .

