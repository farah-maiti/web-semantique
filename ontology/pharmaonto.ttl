po:contientPrincipeActif a owl:ObjectProperty ;
    rdfs:label "contient le principe actif"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:PrincipeActif .

po:Adulte a owl:Class ;
    rdfs:label "Adulte"@fr ;
    rdfs:comment "Patient âgé de 18 ans ou plus, selon la convention du projet."@fr ;
    rdfs:subClassOf po:Patient .

