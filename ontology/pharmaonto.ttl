    po:effetObserve po:Diarrhee ;
    po:frequence "fréquent"^^xsd:string ;
    po:observationDe po:Amoxicilline_BGR_1g .

po:Obs_Clamoxyl_1g_Diarrhee a po:ObservationFrequente,
        owl:NamedIndividual ;
    rdfs:label "Clamoxyl_1g : Diarrhee"@fr ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/64539416/extrait> ;
    po:effetObserve po:Diarrhee ;
    po:frequence "fréquent"^^xsd:string ;
    po:observationDe po:Clamoxyl_1g .

po:Obs_Coumadine_5_Hemorragie a po:ObservationGrave,
        owl:NamedIndividual ;
    rdfs:label "Coumadine_5 : Hemorragie"@fr ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/63245753/extrait> ;
    po:effetObserve po:Hemorragie ;
    po:frequence "non quantifiée dans cet extrait"^^xsd:string ;
    po:observationDe po:Coumadine_5 .

po:Obs_Glucophage_850_AcidoseLactique a po:ObservationGrave,
        po:ObservationTresRare,
        owl:NamedIndividual ;
    rdfs:label "Glucophage_850 : AcidoseLactique"@fr ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/67547090/extrait> ;
