po:ObservationFrequente a owl:Class ;
    rdfs:label "Effet fréquent pour ce médicament"@fr ;
    rdfs:comment "Fréquence entre 1/100 inclus et 1/10 exclu selon le RCP de cette spécialité."@fr ;
    rdfs:subClassOf po:ObservationEffet .

po:ObservationGrave a owl:Class ;
    rdfs:label "Effet potentiellement grave"@fr ;
    rdfs:comment "Gravité indépendante de la fréquence. Les catégories de gravité et fréquence peuvent se recouvrir."@fr ;
