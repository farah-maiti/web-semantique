@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix po: <http://www.esprit.tn/pharmaonto#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:AnnotationProperty .

dcterms:date a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

<http://www.esprit.tn/pharmaonto> a owl:Ontology ;
    rdfs:label "PharmaOnto"@fr ;
    dcterms:creator "Ahmed Saidani",
        "Farah Maiti",
        "Fedi Ben Khalifa" ;
    rdfs:comment "Projet pédagogique Web Sémantique, ESPRIT 5 TWIN 2026-2027. Corpus partiel français, patients fictifs. Les alertes illustrent le raisonnement et ne constituent pas un avis médical."@fr ;
    owl:versionInfo "2.0.0" .

po:FemmeEnceinte a owl:Class ;
    rdfs:label "Patiente enceinte"@fr ;
    rdfs:comment "Catégorie indépendante de la classe d’âge. Aucun scénario de grossesse dans le corpus."@fr ;
    rdfs:subClassOf po:Patient .

po:MedicamentAntiInflammatoire a owl:Class ;
    rdfs:label "Médicament anti-inflammatoire"@fr ;
    rdfs:comment "Classe définie par la présence d’un principe actif anti-inflammatoire."@fr ;
    rdfs:subClassOf po:Medicament ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:AntiInflammatoire ] ) ] .

po:MedicamentAntibiotique a owl:Class ;
    rdfs:label "Médicament antibiotique"@fr ;
    rdfs:comment "Classe définie par la présence d’un principe actif antibiotique."@fr ;
    rdfs:subClassOf po:Medicament ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:Antibiotique ] ) ] .

po:MedicamentAntidiabetique a owl:Class ;
    rdfs:label "Médicament antidiabétique"@fr ;
    rdfs:comment "Classe définie par la présence d’un principe actif antidiabétique."@fr ;
    rdfs:subClassOf po:Medicament ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( po:Medicament [ a owl:Restriction ;
                        owl:onProperty po:contientPrincipeActif ;
                        owl:someValuesFrom po:Antidiabetique ] ) ] .

po:aPourContreIndication a owl:ObjectProperty ;
    rdfs:label "a pour contre-indication"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:ContreIndication .

po:age a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "âge fictif en années"@fr ;
    rdfs:domain po:Patient ;
    rdfs:range xsd:integer .

po:codeCIS a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "code CIS français"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:string .

po:concerne a owl:ObjectProperty ;
    rdfs:label "concerne l’état clinique"@fr ;
    rdfs:domain po:ContreIndication ;
    rdfs:range po:Pathologie .

po:description a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "description de la condition"@fr ;
    rdfs:domain po:ContreIndication ;
    rdfs:range xsd:string .

po:donneeFictive a owl:AnnotationProperty .

po:dosageMg a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "masse par unité en mg"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:decimal .

po:estContreIndiquePour a owl:ObjectProperty ;
    rdfs:label "alerte de contre-indication pour"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:Patient .

po:formeGalenique a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "forme galénique"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:string .

po:frequence a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fréquence pour cette spécialité"@fr ;
    rdfs:domain po:ObservationEffet ;
    rdfs:range xsd:string .

po:interactionMedicamenteuseAvec a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "interaction entre spécialités"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:Medicament .

po:nomCommercial a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "nom de la spécialité"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:string .

po:notePortee a owl:AnnotationProperty .

po:prend a owl:ObjectProperty ;
    rdfs:label "prend dans le scénario"@fr ;
    rdfs:domain po:Patient ;
    rdfs:range po:Medicament .

po:provoque a owl:ObjectProperty ;
    rdfs:label "peut provoquer"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:EffetSecondaire ;
    owl:propertyChainAxiom ( po:aObservationEffet po:effetObserve ) .

po:souffreDe a owl:ObjectProperty ;
    rdfs:label "présente l’état clinique"@fr ;
    rdfs:domain po:Patient ;
    rdfs:range po:Pathologie .

po:substanceDosee a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "substance correspondant à la masse"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range xsd:string .

po:traite a owl:ObjectProperty ;
    rdfs:label "a une indication documentée pour"@fr ;
    rdfs:domain po:Medicament ;
    rdfs:range po:Pathologie ;
    owl:inverseOf po:estTraitePar .

po:Analgesique a owl:Class ;
    rdfs:label "Analgésique"@fr ;
    rdfs:comment "Substance utilisée pour soulager la douleur."@fr ;
    rdfs:subClassOf po:PrincipeActif .

po:Anticoagulant a owl:Class ;
    rdfs:label "Anticoagulant"@fr ;
    rdfs:comment "Substance anticoagulante."@fr ;
    rdfs:subClassOf po:PrincipeActif .

po:CIRelative a owl:Class ;
    rdfs:label "Précaution relative"@fr ;
    rdfs:comment "Catégorie conservée pour extension. Elle ne déclenche pas la règle de contre-indication absolue."@fr ;
    rdfs:subClassOf po:ContreIndication .

po:Enfant a owl:Class ;
    rdfs:label "Enfant"@fr ;
    rdfs:comment "Patient de moins de 18 ans, selon la convention du projet."@fr ;
    rdfs:subClassOf po:Patient .

po:MaladieChronique a owl:Class ;
    rdfs:label "Maladie chronique"@fr ;
    rdfs:comment "Affection chronique."@fr ;
    rdfs:subClassOf po:Pathologie .

po:MaladieInfectieuse a owl:Class ;
    rdfs:label "Maladie infectieuse"@fr ;
    rdfs:comment "Affection infectieuse."@fr ;
    rdfs:subClassOf po:Pathologie .

po:Obs_Advil_400_TroublesDigestifs a po:ObservationEffet,
        owl:NamedIndividual ;
    rdfs:label "Advil_400 : TroublesDigestifs"@fr ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source <https://base-donnees-publique.medicaments.gouv.fr/medicament/63646874/extrait> ;
    po:effetObserve po:TroublesDigestifs ;
    po:frequence "non quantifiée dans cet extrait"^^xsd:string ;
    po:observationDe po:Advil_400 .

po:Obs_Amoxicilline_BGR_1g_Diarrhee a po:ObservationFrequente,
