# Composition et masse par unité
PREFIX po: <http://www.esprit.tn/pharmaonto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?medicament ?nom ?molecule ?dosage ?substanceDosee ?source WHERE {
 ?medicament po:contientPrincipeActif ?actif ; po:nomCommercial ?nom ; po:dosageMg ?dosage ; po:substanceDosee ?substanceDosee ; dct:source ?source .
 ?actif rdfs:label ?molecule . 
 } ORDER BY ?nom
LIMIT 200