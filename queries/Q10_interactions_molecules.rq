# Interactions entre substances
PREFIX po: <http://www.esprit.tn/pharmaonto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?actif ?nom ?autre ?nomAutre WHERE {
 ?actif po:interagitAvec ?autre ; rdfs:label ?nom . ?autre rdfs:label ?nomAutre . 
 } ORDER BY ?nom
LIMIT 200